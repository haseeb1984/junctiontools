RewriteEngine On

# Security headers for the public site.
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# Central AdSense publisher integration for all HTML responses.
# Google recommends the AdSense snippet in the page <head>; this response-body
# filter injects the exact snippet immediately before </head> without requiring
# every static tool page to duplicate it. If mod_substitute is unavailable on
# the hosting account, the existing static pages remain unaffected and the
# hosting environment must enable the module before AdSense can be verified.
<IfModule mod_substitute.c>
    AddOutputFilterByType SUBSTITUTE text/html
    SubstituteMaxLineLength 10m
    Substitute "s|</head>|<script async src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2009027605349204\" crossorigin=\"anonymous\"></script></head>|i"
</IfModule>

Options -Indexes
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|.*\.(sql|bak|old|orig|log|ini))$">
    Require all denied
</FilesMatch>

# Shared static site components are intentionally public because the static HTML
# pages load them client-side. Explicitly grant access so local Apache/XAMPP
# authorization inherited from a stricter parent/vhost cannot return 403.
<FilesMatch "^(header|footer)\.html$">
    Require all granted
</FilesMatch>

<IfModule mod_authz_core.c>
    <FilesMatch "^(url-validator|safe-http|rate-limit)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>

<LimitExcept GET POST HEAD OPTIONS>
    Require all denied
</LimitExcept>

# Public scanner requests use the compatibility shim, which delegates all
# non-legacy-local cases to scanner-secure.php.
RewriteRule ^scanner\.php$ scanner-compat.php [END]

RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
