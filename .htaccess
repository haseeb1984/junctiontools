RewriteEngine On

# Security headers for the public site.
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

Options -Indexes
<FilesMatch "^(\.env|\.git|composer\.(json|lock)|.*\.(sql|bak|old|orig|log|ini))$">
    Require all denied
</FilesMatch>

<IfModule mod_authz_core.c>
    <FilesMatch "^(url-validator|safe-http|rate-limit)\.php$">
        Require all denied
    </FilesMatch>
</IfModule>

<LimitExcept GET POST HEAD OPTIONS>
    Require all denied
</LimitExcept>

# Public scanner requests use the compatibility shim, which delegates all
# non-legacy-local cases to scanner-secure.php.
RewriteRule ^scanner\.php$ scanner-compat.php [END]

RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]
