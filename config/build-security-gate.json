{
  "schema_version": "1.0.0",
  "policy_version": "1.0.0",
  "default_decision": "reject",
  "missing_decision": "reject",
  "allowed_decisions": ["allow", "reject"],
  "required_conditions": {
    "valid_spec": true,
    "safe_slug": true,
    "approved_template": true,
    "no_dynamic_code_execution": true,
    "no_credential_handling": true,
    "no_unsafe_filesystem_access": true,
    "no_arbitrary_url_fetch": true,
    "no_unapproved_external_network_dependency": true,
    "bounded_resource_usage": true,
    "privacy_contract_present": true
  },
  "blocked_conditions": [
    "invalid_spec",
    "unsafe_slug",
    "unapproved_template",
    "dynamic_code_execution",
    "credential_handling",
    "unsafe_filesystem_access",
    "path_traversal",
    "arbitrary_url_fetch",
    "ssrf_risk",
    "unapproved_external_network_dependency",
    "unbounded_resource_usage",
    "sensitive_or_regulated_functionality",
    "missing_privacy_contract",
    "missing_security_requirements"
  ],
  "allowed_evaluators": ["build-security-gate-v1"]
}
