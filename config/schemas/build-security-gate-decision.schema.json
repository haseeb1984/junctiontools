{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junctiontools.com/schemas/build-security-gate-decision.schema.json",
  "title": "JunctionTools Pre-Build Security Gate Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","policy_version","generated_at","evaluator_id","source","type","decision","safe_to_build","conditions","blocked_conditions","approval_requirements","evidence"],
  "properties": {
    "schema_version": {"type":"string","const":"1.0.0"},
    "policy_version": {"type":"string","minLength":1},
    "generated_at": {"type":"string","format":"date-time"},
    "evaluator_id": {"type":"string","enum":["build-security-gate-v1"]},
    "source": {
      "type":"object","additionalProperties":false,"required":["opportunity_id","specification_slug"],
      "properties": {
        "opportunity_id":{"type":"string","minLength":1},
        "specification_slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"}
      }
    },
    "type":{"type":"string","enum":["new_tool","enhancement"]},
    "decision":{"type":"string","enum":["allow","reject"]},
    "safe_to_build":{"type":"boolean"},
    "conditions":{"type":"object","additionalProperties":{"type":"boolean"}},
    "blocked_conditions":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "approval_requirements":{
      "type":"object","additionalProperties":false,"required":["generation_approval","enhancement_approval"],
      "properties":{"generation_approval":{"type":"boolean"},"enhancement_approval":{"type":"boolean"}}
    },
    "evidence":{
      "type":"object","additionalProperties":false,"required":["spec_sha256","policy_sha256"],
      "properties":{
        "spec_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "policy_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    },
    "enhancement":{
      "type":["object","null"],"additionalProperties":false,
      "properties":{
        "target_tool_slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "scope":{
          "type":"object","additionalProperties":false,
          "required":["type","description","requested_capabilities","affected_components","preserve_existing_functionality"],
          "properties":{
            "type":{"type":"string","enum":["feature","bug-fix","security-hardening","performance","accessibility","seo","ui","compatibility"]},
            "description":{"type":"string","minLength":10,"maxLength":2000},
            "requested_capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
            "affected_components":{"type":"array","uniqueItems":true,"items":{"type":"string","enum":["html","css","javascript","tool-spec","content","seo","validation","tests"]}},
            "preserve_existing_functionality":{"const":true}
          }
        }
      }
    }
  },
  "oneOf":[
    {
      "properties":{
        "type":{"const":"new_tool"},
        "enhancement":{"const":null},
        "approval_requirements":{"properties":{"generation_approval":{"const":true},"enhancement_approval":{"const":false}}}
      }
    },
    {
      "required":["enhancement"],
      "properties":{
        "type":{"const":"enhancement"},
        "enhancement":{"type":"object","required":["target_tool_slug","scope"]},
        "approval_requirements":{"properties":{"generation_approval":{"const":false},"enhancement_approval":{"const":true}}}
      }
    }
  ]
}
