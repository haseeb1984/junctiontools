{
  "schema_version": "1.1.0",
  "name": "JunctionTools Continuous Tool Factory",
  "mode": "continuous-automated-build-with-human-publication-review",
  "automatic_production_publish": false,
  "stages": [
    {
      "id": "search-demand",
      "phase": 3,
      "script": "tools/build-demand-opportunities.php",
      "enabled": true
    },
    {
      "id": "tool-intent-filter-and-generation-queue",
      "phase": 3,
      "script": "tools/build-generation-queue.php",
      "enabled": true
    },
    {
      "id": "tool-specification",
      "phase": 4,
      "script": "tools/build-tool-specs.php",
      "enabled": true
    },
    {
      "id": "pre-build-security-gate",
      "phase": 5,
      "script": "security/build-security-gate.php",
      "enabled": true
    },
    {
      "id": "automated-build-authorization",
      "phase": 5,
      "script": "tools/build-automatic-generation-authorization.php",
      "execution_policy": "security-gate-allow-only",
      "enabled": true
    },
    {
      "id": "automated-generation",
      "phase": 5,
      "script": "tools/generate-approved-tools.php",
      "execution_policy": "no-human-generation-approval",
      "enabled": true
    },
    {
      "id": "automated-existing-tool-enhancement-staging",
      "phase": 5,
      "script": "tools/apply-approved-tool-enhancements.php",
      "execution_policy": "security-gate-allow-only",
      "enabled": true
    },
    {
      "id": "runtime-validation",
      "phase": 6,
      "script": "tests/validate-generated-runtime.php",
      "enabled": true
    },
    {
      "id": "adsense-publication-gate",
      "phase": 7,
      "script": "security/adsense-compliance-gate.php",
      "enabled": true
    },
    {
      "id": "publication-review-manifest",
      "phase": 7,
      "script": "tools/build-publication-review-manifest.php",
      "execution_policy": "final-human-publication-review-only",
      "enabled": true
    },
    {
      "id": "approved-new-tool-publication",
      "phase": 7,
      "script": "tools/publish-approved-new-tool.php",
      "execution_policy": "manual-final-approval-only",
      "enabled": true
    },
    {
      "id": "site-navigation-sync",
      "phase": 7,
      "script": "tools/sync-site-navigation.php",
      "enabled": true
    },
    {
      "id": "search-console-feedback",
      "phase": 8,
      "script": "tools/build-search-console-generation-queue.php",
      "enabled": true
    },
    {
      "id": "automatic-publishing-gate",
      "phase": 9,
      "script": "tools/evaluate-automatic-publishing.php",
      "enabled": true
    }
  ],
  "safety": {
    "fail_closed": true,
    "never_modify_registry_or_sitemap_during_generation_or_validation": true,
    "registry_or_sitemap_changes_only_through_final_publication_gate": true,
    "never_publish_without_explicit_human_publication_approval": true,
    "never_require_human_approval_for_generation": true,
    "never_commit_credentials": true,
    "production_publish_requires_separate_review": true,
    "published_tool_navigation_must_sync": true,
    "non_tool_demand_policy": "Reject demand without explicit utility/tool intent before specification.",
    "enhancement_policy": "Existing-tool enhancements may be automatically staged after Security Gate; production files, registry, and sitemap remain unchanged until final publication review."
  }
}
